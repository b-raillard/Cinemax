"whatsNew.accessibility.title" = "Barrierefreier";
"whatsNew.accessibility.body" = "VoiceOver sagt an, ob ein Titel gesehen oder angefangen ist, und nennt Serie, Staffel und Folge auf den Karten „Weiterschauen“ und „Als Nächstes“. Die Beschriftungen der Karten sind besser lesbar, und durchscheinende Bereiche berücksichtigen „Transparenz reduzieren“ und „Kontrast erhöhen“.";
"whatsNew.underTheHood.title" = "Unter der Haube";
"whatsNew.underTheHood.body" = "Diese Version behebt Fehler und macht die App schlanker. Vor allem die Wiedergabe: Sie fängt sich jetzt von selbst, wenn der Server sie kurz nicht mehr versorgt, statt auf einem eingefrorenen Bild stehen zu bleiben.";
"whatsNew.watchTogether.title" = "Gemeinsam schauen";
"whatsNew.watchTogether.body" = "Schau denselben Film mit anderen: Pause, Fortsetzen und Spulen sind sekundengenau synchron. Die anderen treten der Sitzung über die Reihe „Live“ auf ihrer Startseite bei.";
"whatsNew.playOn.title" = "Abspielen auf …";
"whatsNew.playOn.body" = "Sende einen Film an dein Apple TV, ein Tablet oder ein Smartphone, sofern die App auf beiden Geräten mit demselben Konto geöffnet ist.";
"whatsNew.playlists.title" = "Deine Playlists";
"whatsNew.playlists.body" = "Erstelle eine Liste aus jedem beliebigen Poster, ordne sie per Ziehen neu und finde sie auf deiner Startseite wieder.";

